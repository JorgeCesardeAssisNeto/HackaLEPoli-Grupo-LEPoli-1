# Credenciais e configuração da ROOK API (local) / configure as mesmas variáveis no Render
ROOK_API_BASE_URL=https://api.rook-connect.com
ROOK_CLIENT_UUID=
ROOK_SECRET_KEY=
# Vazio ou "YOUR_..." => webhook aceita sem validar assinatura
ROOK_WEBHOOK_SECRET=

# Render PostgreSQL (postgres:// é convertido para postgresql+asyncpg:// automaticamente)
# DATABASE_URL=postgres://user:pass@host/db

FHIR_LAB_SERVICE_URL=http://localhost:5000
NHANES_BASELINE_SERVICE_URL=http://localhost:5055

# True apenas em desenvolvimento local (aceita webhook sem assinatura)
DEBUG=false
ENABLE_BACKGROUND_POLLING=true
POLLING_CRON_HOUR=4
POLLING_CRON_MINUTE=0
POLLING_LOOKBACK_DAYS=2

