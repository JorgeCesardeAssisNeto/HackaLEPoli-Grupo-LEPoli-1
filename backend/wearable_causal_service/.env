# Copie para .env e preencha com as credenciais do painel Terra (https://dashboard.tryterra.co)
TERRA_DEV_ID=seu-dev-id
TERRA_API_KEY=sua-api-key
TERRA_WEBHOOK_SECRET=seu-signing-secret

FHIR_LAB_SERVICE_URL=http://localhost:5000
NHANES_BASELINE_SERVICE_URL=http://localhost:5055

# True apenas em desenvolvimento local (aceita webhook sem assinatura)
DEBUG=false
ENABLE_BACKGROUND_POLLING=true
POLLING_CRON_HOUR=4
POLLING_CRON_MINUTE=0

