# Copie para .env. Credenciais no ROOK Portal (https://portal.tryrook.io) -> Settings/Credentials
ROOK_API_BASE_URL=https://api.rook-connect.com
ROOK_CLIENT_UUID=seu-client-uuid
ROOK_CLIENT_SECRET=seu-secret-key
# Opcional: segredo do webhook (se vazio usa ROOK_CLIENT_SECRET)
ROOK_WEBHOOK_SECRET=

FHIR_LAB_SERVICE_URL=http://localhost:5000
NHANES_BASELINE_SERVICE_URL=http://localhost:5055

# True apenas em desenvolvimento local (aceita webhook sem X-ROOK-HASH)
DEBUG=false
ENABLE_BACKGROUND_POLLING=true
POLLING_CRON_HOUR=4
POLLING_CRON_MINUTE=0
POLLING_LOOKBACK_DAYS=2
